# Build: docker build -f Dockerfile.query-api -t timadorus/query-api .
# Run:   docker run -p 8082:8082 --env-file .env timadorus/query-api

FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/query-api ./cmd/query-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/query-api /query-api
EXPOSE 8082
ENTRYPOINT ["/query-api"]
